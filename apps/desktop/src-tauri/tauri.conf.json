{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidy",
  "version": "0.2.3",
  "identifier": "land.tidy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tidy",
        "url": "index.html#/main",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "search",
        "title": "Tidy 검색",
        "url": "index.html#/search",
        "width": 760,
        "height": 520,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true
      },
      {
        "label": "confirm",
        "title": "Tidy 확인",
        "url": "index.html#/confirm",
        "width": 460,
        "height": 420,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "wizard",
        "title": "Tidy 시작하기",
        "url": "index.html#/wizard",
        "width": 820,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tidy",
    "copyright": "MIT",
    "category": "Productivity",
    "shortDescription": "바탕화면·폴더 자동 정리와 본문 검색",
    "longDescription": "Tidy는 바탕화면과 지정 폴더를 감시해 규칙/AI로 파일을 정리하고, 본문까지 인덱싱해 단어와 의미로 검색합니다. 모든 이동은 기록되고 되돌릴 수 있습니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ko-KR"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
