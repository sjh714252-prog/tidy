{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tidy windows: app commands + events + hiding/focusing their own window",
  "windows": [
    "main",
    "search",
    "confirm",
    "wizard"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
